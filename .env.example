# Copy to .env for non-secret settings only. NEVER put AWS keys here.
# AWS credentials come from PowerShell env vars / AWS Academy / an IAM role.
AWS_REGION=us-east-1
DDB_TABLE=StudentResources
SNS_TOPIC_NAME=StudentResourceVaultNotifications
SNS_TOPIC_ARN=
S3_BUCKET=your-existing-bucket-name
# Optional: prefix added to filenames when a record has no explicit S3 key
S3_KEY_PREFIX=
PRESIGN_SECONDS=300
# Optional attribute-name overrides (set after running scripts/inspect_aws.py)
# FIELD_ID=  FIELD_TITLE=  FIELD_SUBJECT=  FIELD_CATEGORY=
# FIELD_DESCRIPTION=  FIELD_FILENAME=  FIELD_S3_KEY=  (folder is auto-detected: Folder + FileName -> key)
# Uploads are DISABLED unless ADMIN_TOKEN is set (use a long random string)
ADMIN_TOKEN=
# Explicitly labelled sample data, only when AWS is unavailable
DEMO_MODE=0
